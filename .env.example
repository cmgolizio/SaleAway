# Local development only; docker compose builds its own connection string.
DATABASE_URL=postgres://saleaway:change-me@localhost:5432/saleaway
# Password for the Postgres container (docker compose). Use: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Signs login cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Only emails at this domain can be admins.
ADMIN_EMAIL_DOMAIN=artisanfinewines.com
# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false
